# Example Caddy site block for the host that already runs Caddy (this VPS).
# 1) point DNS:  A  izbori-rezultati.rs  ->  57.131.200.44   (and www)
# 2) append this block to /etc/caddy/Caddyfile and run:  sudo systemctl reload caddy
# HTTPS (Let's Encrypt) is obtained automatically once DNS resolves.

izbori-rezultati.rs, www.izbori-rezultati.rs {
	root * /home/ubuntu/pro/izbori_vizualizacija/map
	encode zstd gzip
	file_server

	# 2026 committee data changes on deploy: revalidate instead of serving stale cache
	header /odbori.html Cache-Control "no-cache, must-revalidate"
	header /izbori2026.html Cache-Control "no-cache, must-revalidate"
	header /podaci.html Cache-Control "no-cache, must-revalidate"
	header /odbori.json Cache-Control "no-cache, must-revalidate"
	header /odbori-voters.json Cache-Control "no-cache, must-revalidate"
	header /odbori-meta.json Cache-Control "no-cache, must-revalidate"
	header /odbori.csv Cache-Control "no-cache, must-revalidate"

	# generated data file is big but immutable -> let the browser cache it
	header /data.json  Cache-Control "public, max-age=86400"
	header /index.html Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
	}
}
